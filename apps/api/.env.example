# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ── Database (Supabase PostgreSQL) ────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Object Storage (added later, leave blank for now) ─
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=flp-union-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# ── Push Notifications (added later, leave blank) ────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
EXPO_ACCESS_TOKEN=

# ── Rate Limiting ────────────────────────────────────
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5